# ==============================================================================
# S1 SAÚDE | CONFIGURAÇÃO DE AMBIENTE & VARIÁVEIS SECRETAS (TEMPLATE)
# Copie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA suba o arquivo .env preenchido para o GitHub!
# ==============================================================================

# 1. Credenciais de Integração com a API do Jira Cloud S1 Saúde
JIRA_USER_EMAIL=seu_email@s1saude.com.br
JIRA_API_TOKEN=seu_token_api_atlassian_aqui
JIRA_BASE_URL=https://s1saude.atlassian.net

# 2. Lista de Usuários Autorizados no Cockpit Executivo (Formato JSON)
# O painel utiliza criptografia de nível bancário AES-256-GCM (PBKDF2-SHA256).
# Cada usuário terá sua chave de cofre gerada a partir da respectiva senha informada.
AUTH_USERS_JSON=[{"user": "marcelo.guedes", "pass": "sua_senha_aqui", "nome": "Marcelo Guedes", "perfil": "Analista de Sistemas"}, {"user": "rubia.felix", "pass": "sua_senha_aqui", "nome": "Rubia Felix", "perfil": "Diretora de Operações"}]

# 3. Fallback opcional caso não queira usar a lista estruturada em JSON:
# PASS_USER_S1=sua_senha_padrao
# PASS_LOGIN=sua_senha_padrao
